#!/usr/bin/env bash
# install-tar-gui: menu principal (Instalar / Configurações / Sair).
# Drag-and-drop de arquivos pula o menu e instala direto.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ENGINE="$SELF_DIR/install-tar"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/install-tar"
CONFIG_FILE="$CONFIG_DIR/config"

PREFIX="${PREFIX:-$HOME/.local}"
JOBS="${JOBS:-$(nproc 2>/dev/null || echo 2)}"
CLEANUP="${CLEANUP:-1}"
UPDATE_MENU="${UPDATE_MENU:-1}"
DOWNLOAD_DIR="${DOWNLOAD_DIR:-$HOME/Downloads}"

load_config() { [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"; }

save_config() {
  mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG_FILE" <<EOF
# install-tar settings
PREFIX=$PREFIX
JOBS=$JOBS
CLEANUP=$CLEANUP
UPDATE_MENU=$UPDATE_MENU
DOWNLOAD_DIR=$DOWNLOAD_DIR
EOF
}

pick_files() {
  load_config
  mapfile -t picked < <(kdialog --title "Instalar pacote" \
    --getopenfilename "$DOWNLOAD_DIR" \
    "*.tar.gz *.tgz *.tar.xz *.txz *.tar.bz2 *.tbz2 *.tar *.zip | Pacotes comprimidos" \
    --multiple --separate-output 2>/dev/null)
  printf '%s\n' "${picked[@]}"
}

install_list() {
  local -a files=("$@")
  [ "${#files[@]}" -eq 0 ] && return 0
  local rc=0
  for f in "${files[@]}"; do
    echo; echo "############### $f"
    if ! "$ENGINE" "$f"; then
      rc=1; echo; echo "!!! FALHOU: $f"
    fi
  done
  load_config
  if [ "$rc" -eq 0 ]; then
    notify-send -i package-x-generic "Instalação concluída" "${#files[@]} pacote(s) em $PREFIX/bin" 2>/dev/null || true
    kdialog --title "Instalar pacote" --msgbox "Concluído: ${#files[@]} pacote(s) instalado(s) em $PREFIX/bin." 2>/dev/null
  else
    notify-send -i dialog-error "Instalação com falhas" "Veja o terminal." 2>/dev/null || true
    kdialog --title "Instalar pacote" --error "Falha em um ou mais pacotes. Veja o terminal." 2>/dev/null
  fi
}

show_settings() {
  load_config
  local p_new
  p_new="$(kdialog --title "Config - install-tar" --getexistingdirectory "$PREFIX" "PREFIX (diretório de instalação):")"
  [ -z "$p_new" ] && return 0
  PREFIX="$p_new"

  local j_new
  j_new="$(kdialog --title "Config - install-tar" --inputbox "JOBS (compilação paralela):" "$JOBS")"
  case "$j_new" in ''|*[!0-9]*) return 0;; *) JOBS="$j_new";; esac

  if kdialog --title "Config - install-tar" --yesno "Limpar temporários após instalar?"; then CLEANUP=1; else CLEANUP=0; fi
  if kdialog --title "Config - install-tar" --yesno "Atualizar menu de aplicativos automaticamente?"; then UPDATE_MENU=1; else UPDATE_MENU=0; fi

  local d_new
  d_new="$(kdialog --title "Config - install-tar" --getexistingdirectory "$DOWNLOAD_DIR" "Pasta de downloads (abertura do seletor):")"
  [ -n "$d_new" ] && DOWNLOAD_DIR="$d_new"

  save_config
  kdialog --title "Config - install-tar" --msgbox "Configurações salvas em:\n$CONFIG_FILE" 2>/dev/null
}

# --- entrada: se arquivos foram arrastados, instala direto ---
if [ "$#" -gt 0 ] && [ "${1#--}" = "$1" ]; then
  install_list "$@"
  exit $?
fi

# menu principal (loop até sair)
load_config
while true; do
  choice="$(kdialog --title "install-tar" \
    --default "Instalar" \
    --menu "O que deseja fazer?" \
    "Instalar" "Escolher pacote(s) .tar.gz e instalar" \
    "Config"  "Alterar PREFIX, JOBS, limpeza, menu" \
    "Sair"    "Fechar" 2>/dev/null)"
  case "$choice" in
    "Instalar")
      picked="$(pick_files)"
      [ -n "$picked" ] && install_list $picked
      ;;
    "Config") show_settings ;;
    "Sair"|"") exit 0 ;;
  esac
done